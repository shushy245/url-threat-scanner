# ---- runtime ----
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ---- postgres ----
DATABASE_URL=postgres://scanner:scanner@localhost:5433/scanner

# ---- rabbitmq ----
RABBITMQ_URL=amqp://scanner:scanner@localhost:5672

# ---- pipeline ----
# simulated | real  — see docs/adr/adr-0005-simulated-checks.md
CHECK_MODE=simulated
CHECK_TIMEOUT_MS=5000
WORKER_PREFETCH=10
MAX_REDELIVERIES=10

# ---- outbox relay ----
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=100

# ---- auth ----
# comma-separated  clientId:sha256(apiKey)  pairs. Never store raw keys.
# dev key below is the sha256 of "dev-key"
API_KEYS=dev-sensor:7e9f8fd111802be56c379d597842e29b2cebd35ff2133d431a49fa556a18704e
